# Copy to .env (or export these) before running the API.
APP_NAME=ScanBite
DATABASE_PATH=data/products.db
# Load the 8 fictional demo products on start-up.
SEED_SAMPLES=true
# Fall back to Open Food Facts for barcodes we don't have.
OFF_ENABLED=true
OFF_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts asks apps to identify themselves. Use your real contact email.
OFF_USER_AGENT=ScanBite/0.1 (you@example.com)
OFF_TIMEOUT_S=4
CORS_ORIGINS=*
# Shared secret for POST /v1/products (add a product read off a pack).
# Leave empty and submissions are refused outright with 503. Submitted records
# are always stored as `provisional`, never `verified`.
ADMIN_TOKEN=
