# Normalise line endings: LF in the repo, native in the working copy.
* text=auto eol=lf

# Shell scripts must keep LF or they break in Docker and CI.
*.sh text eol=lf
Dockerfile text eol=lf

# Binary files git should never try to normalise or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.db binary
