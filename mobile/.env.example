# Copy to .env. Restart `npm start` after changing it.
EXPO_PUBLIC_APP_NAME=ScanBite

# Your laptop's Wi-Fi IP where the backend runs (phone and laptop on the same Wi-Fi).
# Leave empty to run in demo mode with the 8 bundled sample products.
EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# Force demo mode even when an API URL is set.
EXPO_PUBLIC_DEMO_MODE=false

# Where "Report a mistake" emails go. Leave empty to hide the button.
EXPO_PUBLIC_SUPPORT_EMAIL=
